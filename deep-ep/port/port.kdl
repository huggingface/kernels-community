"""#

// Handwritten Torch bindings, runtime checks, CI subset and docs.
overlay from="overlay"

// Only the three host translation units compile; GPU kernels retain runtime JIT.
kernel name="deep_ep" backend="cuda" src="csrc/**/*.hpp,csrc/kernels/comm/context.cpp,csrc/kernels/driver/driver.cpp,deep_ep/include/**,third-party/deep_jit/include/deep_jit/{backend/cuda,cache,runtime,utils}/**,third-party/nccl/include/**,torch-ext/compat/**/*.h" \
    capabilities="9.0a,10.0a" depends="torch" \
    include="torch-ext/compat,csrc,deep_ep/include,third-party/deep_jit/include,third-party/nccl/include" \
    cxx_flags="-std=c++20,-O3,-DDEEP_EP_KERNELS,-Wno-deprecated-declarations,-Wno-unused-variable,-Wno-sign-compare,-Wno-reorder,-Wno-attributes"

manifest name="deep-ep" version=1 edition=6 license="MIT" \
    upstream="https://github.com/deepseek-ai/DeepEP" backends="cuda" \
    repo_id="kernels-community/deep-ep" cuda_minver="13.0" \
    torch_src="torch-ext/*.{cpp,hpp}" torch_pyext="py,cuh" \
    torch_include="torch-ext,torch-ext/compat,csrc,deep_ep/include,third-party/deep_jit/include,third-party/nccl/include"

// The experimental manifest op does not expose Torch binding flags directly.
// Preserve the existing binding flags through a guarded generated-table edit.
replace in="build.toml" count=1 find="[torch]\n" with=#"""
[torch]
cxx-flags = ["-std=c++20", "-DDEEP_EP_KERNELS", "-Wno-deprecated-declarations", "-Wno-unused-variable", "-Wno-sign-compare", "-Wno-reorder", "-Wno-attributes"]

"""#

expect in="torch-ext/deep_ep/**/*.py" find="import deep_ep" count=0
expect in="build.toml" find="stable-abi" count=0
