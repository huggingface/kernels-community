recipe version=1

// DeepEP 2.5.0 and its exact DeepJIT dependency.
source repo="https://github.com/deepseek-ai/DeepEP.git" commit="def865146e95aa9ea223e277c0a8a4c6b81e5ac7"
prune keep=".clang-format,.editorconfig,.gitignore,.gitmodules,.github/workflows/format.yml,third-party/tilelang_ops/**,LICENSE,README.md,format.sh,requirements-lint.txt,csrc/**,deep_ep/**,tests/**,figures/**"
// Retain the upstream layout, and derive the Hub Python package from the same pin.
vendor name="python" repo="https://github.com/deepseek-ai/DeepEP.git" commit="def865146e95aa9ea223e277c0a8a4c6b81e5ac7" path="deep_ep" to="torch-ext/deep_ep"
vendor name="deepjit" repo="https://github.com/deepseek-ai/DeepJIT.git" commit="cba802df081985141eeee36803685775c183a047" path="." to="third-party/deep_jit"

// Header-only NCCL dependency; reproduce the public headers from pinned source.
vendor name="nccl" repo="https://github.com/NVIDIA/nccl.git" commit="12df1a11afad322be5a204a2db890161cbf8131d" path="." to="third-party/nccl-source"
move from="third-party/nccl-source/src/nccl.h.in" to="third-party/nccl/include/nccl.h"
move from="third-party/nccl-source/src/include/nccl_device.h" to="third-party/nccl/include/nccl_device.h"
move from="third-party/nccl-source/src/include/nccl_device" to="third-party/nccl/include/nccl_device"
move from="third-party/nccl-source/bindings/ir/nccl_device_wrapper.h" to="third-party/nccl/include/nccl_device_wrapper.h"
move from="third-party/nccl-source/LICENSE.txt" to="third-party/nccl/LICENSE.txt"
move from="third-party/nccl-source/src/transport/net_ib/gdaki/doca-gpunetio/include/common" to="third-party/nccl/include/nccl_device/gin/gdaki/doca_gpunetio/common"
move from="third-party/nccl-source/src/transport/net_ib/gdaki/doca-gpunetio/include/device" to="third-party/nccl/include/nccl_device/gin/gdaki/doca_gpunetio/device"
move from="third-party/nccl-source/src/transport/net_ib/gdaki/doca-gpunetio/include/doca_gpunetio_device.h" to="third-party/nccl/include/nccl_device/gin/gdaki/doca_gpunetio/doca_gpunetio_device.h"
move from="third-party/nccl-source/src/transport/net_efa_gda/efa-dp-direct/include/common" to="third-party/nccl/include/nccl_device/transport/net_efa_gda/efa-dp-direct/include/common"
move from="third-party/nccl-source/src/transport/net_efa_gda/efa-dp-direct/include/device" to="third-party/nccl/include/nccl_device/transport/net_efa_gda/efa-dp-direct/include/device"
delete in="third-party/nccl/include/nccl_device/README.md"
replace in="third-party/nccl/include/nccl.h" find="${nccl:Major}" with="2" count=1
replace in="third-party/nccl/include/nccl.h" find="${nccl:Minor}" with="32" count=1
replace in="third-party/nccl/include/nccl.h" find="${nccl:Patch}" with="3" count=1
replace in="third-party/nccl/include/nccl.h" find="${nccl:Suffix}" with="" count=1
replace in="third-party/nccl/include/nccl.h" find="${nccl:Version}" with="23203" count=1

prune keep=".clang-format,.editorconfig,.gitignore,.gitmodules,.github/workflows/format.yml,third-party/tilelang_ops/**,LICENSE,README.md,format.sh,requirements-lint.txt,csrc/**,deep_ep/**,tests/**,figures/**,torch-ext/**,third-party/deep_jit/**,third-party/nccl/include/**,third-party/nccl/LICENSE.txt"

// The Hub loader imports under a generated module name.
convert_import in="torch-ext/deep_ep/**/*.py" prefix="deep_ep" changes=10
relativize_imports in="torch-ext/deep_ep/**/*.py" package_root="torch-ext/deep_ep" changes=13


