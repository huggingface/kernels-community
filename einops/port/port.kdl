recipe version=1

source \
    repo="https://github.com/arogozhnikov/einops.git" \
    commit="ad2c8d67d08cbebb45e1aff2be21dc88635fc695"

// Carry over the package and its tests, minus upstream's test launcher.
prune keep="einops/**"
delete in="einops/tests/run_tests.py"
move from="einops/tests" to="tests"
move from="einops" to="torch-ext/einops"

// Make package-internal imports work under the Hub-generated module name.
relativize_imports in="torch-ext/einops/**" package_root="torch-ext/einops" changes=7

// Expose array_api because Hub consumers cannot import it by package name.
ensure_import in="torch-ext/einops/__init__.py" from="." name="array_api" changes=1

// Point imports of the former einops.tests package at the lifted tests.
remap_module in="tests/*.py" from="einops.tests" to="tests" changes=7
relativize_imports in="tests/*.py" package_root="tests" changes=7

// Resolve product imports through the locally built Hub kernel. The package
// init binds it privately so `from . import *` cannot pick it up.
kernelize_imports \
    in="tests/__init__.py" \
    package="einops" \
    binding="_einops" \
    kernel="kernels-community/einops" \
    version=1 \
    changes=1

kernelize_imports \
    in="tests/test_*.py" \
    package="einops" \
    kernel="kernels-community/einops" \
    version=1 \
    changes=25

// Default to the CI backends, while allowing local overrides.
replace in="tests/__init__.py" \
    find="ENVVAR_NAME = \"EINOPS_TEST_BACKENDS\"\n" \
    with="ENVVAR_NAME = \"EINOPS_TEST_BACKENDS\"\nos.environ.setdefault(ENVVAR_NAME, \"torch,numpy\")\n"

// Use the supported replacement for NumPy 2's removed in1d API.
replace in="tests/test_layers.py" \
    find="numpy.in1d(grad, [0, 1])" \
    with="numpy.isin(grad, [0, 1])"

// Select every upstream test for the kernel CI suite.
mark_tests in="tests/test_*.py" marker="kernels_ci" changes=63

manifest \
    name="einops" \
    version=1 \
    edition=6 \
    license="MIT" \
    upstream="https://github.com/arogozhnikov/einops.git" \
    backends="cpu,cuda,metal,rocm,xpu" \
    repo_id="kernels-community/einops" \
    noarch=#true
