recipe version=1

// Pin the exact clean upstream tree this recipe transforms. Flash Attention 3
// lives in hopper/ of the flash-attention repository.
source \
    repo="https://github.com/Dao-AILab/flash-attention.git" \
    commit="0816ef12f424c6ec94b057a72c275b14f6e6edb2"

// Retain the CUDA sources, the Python interface, and the tests this kernel
// carries. Benchmarks, setup.py, the ROCm/Triton path and the other upstream
// test modules are out of scope.
prune keep="hopper/*.{h,hpp,cu,cpp},hopper/instantiations/*.cu,hopper/flash_attn_interface.py,hopper/{padding,test_util,test_flash_attn}.py"

move \
    from="hopper/flash_attn_interface.py" \
    to="torch-ext/flash_attn3/flash_attn_interface.py"

move from="hopper/padding.py" to="tests/padding.py"
move from="hopper/test_util.py" to="tests/test_util.py"
move from="hopper/test_flash_attn.py" to="tests/test_flash_attn.py"

move \
    from="hopper" \
    to="flash-attn"

// Each per-hdim sm90 forward unit is #included by an hdimall/hdimdiff
// aggregate. Turn them into headers so they are only compiled once, through
// their aggregate; the move keeps the aggregates' #includes pointing at them.
move \
    from="flash-attn/instantiations/flash_fwd_hdim[0-9]*_sm90.cu" \
    to="{dir}/{stem}.cuh" \
    files=220 \
    refs=220

// Upstream builds the flash_attn_3._C extension, registering its ops under the
// fixed flash_attn_3 namespace. Register them under the kernel-unique
// namespace instead and dispatch through the kernel's ops. The Python module
// entry point lives in the overlay's torch_binding.cpp. The ROCm/Triton
// fallback is left as upstream has it; it is unreachable in this CUDA-only
// kernel.
extension \
    sources="flash-attn/flash_api_stable.cpp" \
    namespace="flash_attn_3" \
    modules="flash_attn_3._C" \
    changes=9

// flash_attn_config is generated by upstream's setup.py; ours is in the overlay.
// The package init, generated build config, Python module entry point, CI smoke
// tests, the stable ABI shim, docs and benchmarks have no upstream equivalent.
overlay from="overlay"

remap_module \
    in="torch-ext/flash_attn3/flash_attn_interface.py" \
    from="flash_attn_config" \
    to="flash_attn3.flash_attn_config" \
    changes=1

relativize_imports \
    in="torch-ext/flash_attn3/flash_attn_interface.py" \
    package_root="torch-ext/flash_attn3" \
    changes=1

// Tests: import the local helpers relative to the test package.
remap_module in="tests/{test_util,test_flash_attn}.py" from="padding" to="tests.padding" changes=2
remap_module in="tests/test_flash_attn.py" from="test_util" to="tests.test_util" changes=1

relativize_imports \
    in="tests/{test_util,test_flash_attn}.py" \
    package_root="tests" \
    changes=3

// Check the op schemas through the kernel's ops and namespace.
rewrite \
    in="tests/test_flash_attn.py" \
    pattern="torch.ops.flash_attn_3" \
    with="ops" \
    changes=4

rewrite \
    in="tests/test_flash_attn.py" \
    pattern="\"flash_attn_3:::[schema]\"" \
    with="add_op_namespace_prefix(\"\") + \":[schema]\"" \
    changes=4

// The stable API's bwd does not return the mutated gradients as aliases.
rewrite \
    in="tests/test_flash_attn.py" \
    pattern="\"-> (Tensor(dq!), Tensor(dk!), Tensor(dv!), Tensor, Tensor, Tensor, Tensor, Tensor)\"" \
    with="\"-> (Tensor, Tensor, Tensor, Tensor, Tensor)\"" \
    changes=1

// The schema check is cheap; run it in CI next to test_kernels_ci.py.
rewrite \
    in="tests/test_flash_attn.py" \
    pattern="def test_flash3_bw_compatibility(" \
    with="@pytest.mark.kernels_ci\ndef test_flash3_bw_compatibility(" \
    changes=1

remap_module \
    in="tests/test_flash_attn.py" \
    from="flash_attn_interface" \
    to="flash_attn3" \
    changes=2

ensure_import in="tests/test_flash_attn.py" from="flash_attn3" name="ops" changes=1
ensure_import in="tests/test_flash_attn.py" from="flash_attn3" name="add_op_namespace_prefix" changes=1

// Resolve the kernel through the locally built Hub kernel.
kernelize_imports \
    in="tests/test_flash_attn.py" \
    package="flash_attn3" \
    kernel="kernels-community/flash-attn3" \
    version=2 \
    changes=4

// Fail on new upstream sources so they get reviewed rather than silently
// compiled in or dropped.
expect in="flash-attn/*" files=37
expect in="flash-attn/instantiations/*" files=451

// Shared sources for both architectures: combine and scheduler kernels.
kernel \
    name="flash_attn" \
    backend="cuda" \
    src="flash-attn/{cuda_check.h,flash_fwd_combine.cu,flash_fwd_combine_kernel.h,flash_fwd_combine_launch_template.h,flash.h,flash_prepare_scheduler.cu,heuristics.h,seqlen.h,static_switch.h,tile_size.h,utils.h}" \
    depends="torch,cutlass_4_0" \
    capabilities="8.0,9.0a" \
    cuda_flags="-O3,-std=c++17,--ftemplate-backtrace-limit=0,--use_fast_math,-DCUTE_SM90_EXTENDED_MMA_SHAPES_ENABLED,-DCUTLASS_ENABLE_GDC_FOR_SM90,-DCUTLASS_DEBUG_TRACE_LEVEL=0,-DNDEBUG"

// The softcapall instantiations and sm100 are not built: each softcap
// variant is already compiled separately.
kernel \
    name="flash_attn_sm80" \
    backend="cuda" \
    src="flash-attn/{block.h,copy_sm90_bulk_reduce.hpp,epilogue_bwd.hpp,epilogue_fwd.hpp,flash.h,flash_bwd_kernel_sm80.h,flash_bwd_kernel_sm90.h,flash_bwd_launch_template.h,flash_bwd_postprocess_kernel.h,flash_bwd_preprocess_kernel.h,flash_fwd_launch_template.h,flash_fwd_kernel_sm80.h,flash_fwd_kernel_sm90.h,heuristics.h,mainloop_bwd_sm80.hpp,mainloop_fwd_sm80.hpp,mainloop_bwd_sm90_tma_gmma_ws.hpp,mainloop_fwd_sm90_tma_gmma_ws.hpp,mask.h,named_barrier.hpp,pack_gqa.h,paged_kv.h,rotary.h,sm90_pipeline_no_cluster.hpp,softmax.h,tile_size.h,tile_scheduler.hpp},flash-attn/instantiations/flash_bwd_hdim[0-9]*_{bf16,fp16}_{sm80,softcap_sm80}.cu,flash-attn/instantiations/flash_fwd_hdim[0-9]*_{bf16,fp16}_{sm80,softcap_sm80,paged_sm80,paged_softcap_sm80,paged_split_sm80,paged_split_softcap_sm80,split_sm80,split_softcap_sm80}.cu" \
    include="flash-attn" \
    depends="torch,cutlass_4_0" \
    capabilities="8.0" \
    cuda_flags="-O3,-std=c++17,--ftemplate-backtrace-limit=0,--use_fast_math,-DCUTE_SM90_EXTENDED_MMA_SHAPES_ENABLED,-DCUTLASS_ENABLE_GDC_FOR_SM90,-DCUTLASS_DEBUG_TRACE_LEVEL=0,-DNDEBUG"

kernel \
    name="flash_attn_sm90" \
    backend="cuda" \
    src="flash-attn/{block.h,copy_sm90_bulk_reduce.hpp,epilogue_bwd.hpp,epilogue_fwd.hpp,flash.h,flash_bwd_kernel_sm80.h,flash_bwd_kernel_sm90.h,flash_bwd_launch_template.h,flash_bwd_postprocess_kernel.h,flash_bwd_preprocess_kernel.h,flash_fwd_launch_template.h,flash_fwd_kernel_sm80.h,flash_fwd_kernel_sm90.h,heuristics.h,mainloop_bwd_sm80.hpp,mainloop_fwd_sm80.hpp,mainloop_bwd_sm90_tma_gmma_ws.hpp,mainloop_fwd_sm90_tma_gmma_ws.hpp,mask.h,named_barrier.hpp,pack_gqa.h,paged_kv.h,rotary.h,sm90_pipeline_no_cluster.hpp,softmax.h,tile_size.h,tile_scheduler.hpp},flash-attn/instantiations/flash_bwd_hdim[0-9]*_{bf16,fp16}_{sm90,softcap_sm90}.cu,flash-attn/instantiations/flash_fwd_hdim{all,diff}_*_sm90.cu,flash-attn/instantiations/flash_fwd_hdim[0-9]*_sm90.cuh" \
    include="flash-attn" \
    depends="torch,cutlass_4_0" \
    capabilities="9.0a" \
    cuda_flags="-O3,-std=c++17,--ftemplate-backtrace-limit=0,--use_fast_math,-DCUTE_SM90_EXTENDED_MMA_SHAPES_ENABLED,-DCUTLASS_ENABLE_GDC_FOR_SM90,-DCUTLASS_DEBUG_TRACE_LEVEL=0,-DNDEBUG"

manifest \
    name="flash-attn3" \
    version=2 \
    edition=5 \
    license="BSD-3-Clause" \
    upstream="https://github.com/Dao-AILab/flash-attention.git" \
    backends="cuda" \
    cuda_minver="12.6" \
    cuda_maxver="13.0" \
    repo_id="kernels-community/flash-attn3" \
    torch_src="flash-attn/flash_api_stable.cpp,torch-ext/torch_binding.cpp" \
    stable_abi_version="2.9"
